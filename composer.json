{
  "name": "supdger/sand-package",
  "description": "SandAdmin plugin package manager for PostgreSQL hosts.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "supdger/sand-core": "^0.2.4",
    "nelexa/zip": "^4.0",
    "tinywan/jwt": "^1.11",
    "webman/console": "^2.1",
    "workerman/webman-framework": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "SandAdmin\\Package\\": "server/",
      "plugin\\sandpackage\\": "server/plugin/sandpackage/",
      "Saithink\\Saipackage\\": "server/compat/Saithink/Saipackage/"
    }
  },
  "archive": {
    "exclude": [
      "/**/.DS_Store",
      "/**/._*",
      "/**/.git",
      "/**/.gitattributes",
      "/**/.github",
      "/**/.husky",
      "/**/.idea",
      "/**/.vscode",
      "/**/Thumbs.db",
      "/**/commitlint.config.cjs",
      "/**/composer.lock",
      "/**/desktop.ini",
      "/**/dist",
      "/**/lint-staged.config.cjs",
      "/**/lint-staged.config.js",
      "/**/lint-staged.config.mjs",
      "/**/node_modules",
      "/**/tests",
      "/**/vendor",
      "/sandadmin-artd/.env",
      "/sandadmin-artd/.env.development",
      "/tools"
    ]
  }
}